{
  "name": "shopping-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src server shared tests docs *.ts *.json *.js *.html *.md"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
